# Copy to .env (the web installer creates this for you)
APP_URL="https://learn.example.com"
APP_KEY=""            # generated by the installer; never change after install (encrypts secrets & signs video tokens)
APP_DEBUG="false"
APP_PRETTY_URLS="true" # set false if mod_rewrite is unavailable (URLs become /index.php/...)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME=""
DB_USER=""
DB_PASS=""
DB_PREFIX="zx_"
SESSION_NAME="zeroes_sid"
SESSION_LIFETIME="720" # minutes of inactivity
# Mail defaults (can be overridden in Admin → Settings → Email delivery)
MAIL_DRIVER="log"      # smtp | mail | log
MAIL_FROM=""
MAIL_FROM_NAME=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="tls"      # tls | ssl | none
